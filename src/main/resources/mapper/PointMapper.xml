<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.maprouteplanner.mapper.PointMapper">

    <!-- 查询所有 POI -->
    <select id="findAll" resultType="org.example.maprouteplanner.model.Point">
        SELECT
            id,
            name,
            latitude,
            longitude
        FROM points
    </select>

    <!-- 根据单个 ID 查询 -->
    <select id="selectById" parameterType="long" resultType="org.example.maprouteplanner.model.Point">
        SELECT
            id,
            name,
            latitude,
            longitude
        FROM points
        WHERE id = #{id}
    </select>

    <!-- 根据 ID 列表查询 -->
    <select id="selectByIds" parameterType="java.util.List" resultType="org.example.maprouteplanner.model.Point">
        SELECT
        id,
        name,
        latitude,
        longitude
        FROM points
        WHERE id IN
        <foreach item="item" collection="ids" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>

</mapper>
